{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eye.invalid/schemas/eye-wire.v1.schema.json",
  "title": "EYE wire protocol, version 1",
  "description": "Authoritative definition of every REST response and WebSocket message. Uses only the keyword subset listed in schemas/README.md. Client types are generated from this file; both sides validate against it at runtime.",
  "$defs": {
    "SchemaVersion": {
      "description": "Wire protocol version carried by every message.",
      "const": "eye.wire/1"
    },
    "Timestamp": {
      "description": "RFC 3339 instant in UTC with a Z suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Cursor": {
      "description": "Opaque position in the server's update sequence.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "ShortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "Longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "Latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "BBox": {
      "description": "[west, south, east, north] in WGS 84 degrees.",
      "type": "array",
      "items": { "type": "number", "minimum": -180, "maximum": 180 },
      "minItems": 4,
      "maxItems": 4
    },
    "Interval": {
      "type": "object",
      "properties": {
        "start": { "$ref": "#/$defs/Timestamp" },
        "end": { "$ref": "#/$defs/Timestamp" }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "Area": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/ShortText" },
        "bbox": { "$ref": "#/$defs/BBox" }
      },
      "required": ["name", "bbox"],
      "additionalProperties": false
    },
    "DisplayType": {
      "description": "How a displayed state was obtained (brief section 4).",
      "enum": ["observed", "ephemeris", "propagated", "estimated", "illustrative"]
    },
    "TrackPoint": {
      "description": "Source time and server receipt time are separate fields.",
      "type": "object",
      "properties": {
        "observed_time": { "$ref": "#/$defs/Timestamp" },
        "received_time": { "$ref": "#/$defs/Timestamp" },
        "lon": { "$ref": "#/$defs/Longitude" },
        "lat": { "$ref": "#/$defs/Latitude" },
        "alt_m": { "type": ["number", "null"], "minimum": -12000, "maximum": 100000 }
      },
      "required": ["observed_time", "received_time", "lon", "lat", "alt_m"],
      "additionalProperties": false
    },
    "Track": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "kind": { "enum": ["flight", "vessel"] },
        "source": { "$ref": "#/$defs/Identifier" },
        "source_record_id": { "$ref": "#/$defs/Identifier" },
        "display_type": { "$ref": "#/$defs/DisplayType" },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrackPoint" },
          "minItems": 1,
          "maxItems": 1000
        },
        "quality_flags": {
          "type": "array",
          "items": { "$ref": "#/$defs/Identifier" },
          "maxItems": 16
        }
      },
      "required": ["id", "kind", "source", "source_record_id", "display_type", "points", "quality_flags"],
      "additionalProperties": false
    },
    "PointLocation": {
      "type": "object",
      "properties": {
        "type": { "const": "point" },
        "coords": {
          "type": "array",
          "items": { "type": "number", "minimum": -180, "maximum": 180 },
          "minItems": 2,
          "maxItems": 2
        },
        "precision_m": { "type": "number", "minimum": 0, "maximum": 1000000 }
      },
      "required": ["type", "coords", "precision_m"],
      "additionalProperties": false
    },
    "SegmentLocation": {
      "type": "object",
      "properties": {
        "type": { "const": "segment" },
        "coords": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number", "minimum": -180, "maximum": 180 },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 100
        },
        "precision_m": { "type": "number", "minimum": 0, "maximum": 1000000 }
      },
      "required": ["type", "coords", "precision_m"],
      "additionalProperties": false
    },
    "AreaLocation": {
      "type": "object",
      "properties": {
        "type": { "const": "area" },
        "bbox": { "$ref": "#/$defs/BBox" },
        "precision_m": { "type": "number", "minimum": 0, "maximum": 1000000 }
      },
      "required": ["type", "bbox", "precision_m"],
      "additionalProperties": false
    },
    "Location": {
      "oneOf": [
        { "$ref": "#/$defs/PointLocation" },
        { "$ref": "#/$defs/SegmentLocation" },
        { "$ref": "#/$defs/AreaLocation" }
      ]
    },
    "EventRevision": {
      "type": "object",
      "properties": {
        "revision": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "published_time": { "$ref": "#/$defs/Timestamp" },
        "status": { "enum": ["reported", "corrected", "retracted", "cleared"] },
        "location": { "$ref": "#/$defs/Location" }
      },
      "required": ["revision", "published_time", "status", "location"],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Identifier" },
        "kind": { "enum": ["road_closure", "road_incident", "vessel_port_arrival"] },
        "source": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["reported", "corrected", "retracted", "cleared"] },
        "reported_event_location": { "$ref": "#/$defs/Location" },
        "event_time": { "$ref": "#/$defs/Timestamp" },
        "published_time": { "$ref": "#/$defs/Timestamp" },
        "received_time": { "$ref": "#/$defs/Timestamp" },
        "replayed": { "type": "boolean" },
        "revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/EventRevision" },
          "maxItems": 100
        }
      },
      "required": ["id", "kind", "source", "status", "reported_event_location", "event_time", "published_time", "received_time", "replayed", "revisions"],
      "additionalProperties": false
    },
    "CoverageMeasured": {
      "description": "Coverage with a usable measurement. The metric value is a number.",
      "type": "object",
      "properties": {
        "layer": { "enum": ["flight", "vessel", "road"] },
        "interval": { "$ref": "#/$defs/Interval" },
        "state": { "enum": ["qualified", "partial"] },
        "reason": { "$ref": "#/$defs/ShortText" },
        "metric": {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/Identifier" },
            "value": { "type": "number", "minimum": 0 }
          },
          "required": ["name", "value"],
          "additionalProperties": false
        }
      },
      "required": ["layer", "interval", "state", "metric"],
      "additionalProperties": false
    },
    "CoverageMissing": {
      "description": "An outage or unknown coverage. The metric value must be null, never zero.",
      "type": "object",
      "properties": {
        "layer": { "enum": ["flight", "vessel", "road"] },
        "interval": { "$ref": "#/$defs/Interval" },
        "state": { "enum": ["unknown", "failed"] },
        "reason": { "$ref": "#/$defs/ShortText" },
        "metric": {
          "type": "object",
          "properties": {
            "name": { "$ref": "#/$defs/Identifier" },
            "value": { "type": "null" }
          },
          "required": ["name", "value"],
          "additionalProperties": false
        }
      },
      "required": ["layer", "interval", "state", "reason", "metric"],
      "additionalProperties": false
    },
    "Coverage": {
      "oneOf": [
        { "$ref": "#/$defs/CoverageMeasured" },
        { "$ref": "#/$defs/CoverageMissing" }
      ]
    },
    "HealthMessage": {
      "description": "REST GET /api/v0/health.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "kind": { "const": "health" },
        "status": { "const": "ok" },
        "mode": { "enum": ["demo", "production"] },
        "synthetic": { "type": "boolean" }
      },
      "required": ["schema_version", "kind", "status", "mode", "synthetic"],
      "additionalProperties": false
    },
    "ErrorMessage": {
      "description": "Any REST error body, or a WebSocket error before close.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "kind": { "const": "error" },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "error": { "$ref": "#/$defs/ShortText" }
      },
      "required": ["schema_version", "kind", "status", "error"],
      "additionalProperties": false
    },
    "SnapshotMessage": {
      "description": "REST GET /api/v0/snapshot, and the first WebSocket message after subscribe or resync.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "kind": { "const": "snapshot" },
        "cursor": { "$ref": "#/$defs/Cursor" },
        "generated_at": { "$ref": "#/$defs/Timestamp" },
        "synthetic": { "type": "boolean" },
        "notice": { "$ref": "#/$defs/ShortText" },
        "area": { "$ref": "#/$defs/Area" },
        "interval": { "$ref": "#/$defs/Interval" },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/Track" }, "maxItems": 1000 },
        "events": { "type": "array", "items": { "$ref": "#/$defs/Event" }, "maxItems": 1000 },
        "coverage": { "type": "array", "items": { "$ref": "#/$defs/Coverage" }, "maxItems": 1000 }
      },
      "required": ["schema_version", "kind", "cursor", "generated_at", "synthetic", "area", "interval", "tracks", "events", "coverage"],
      "additionalProperties": false
    },
    "DeltaMessage": {
      "description": "WebSocket sequenced update after a snapshot. A gap in sequence requires a new snapshot.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "kind": { "const": "delta" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "cursor": { "$ref": "#/$defs/Cursor" },
        "previous_cursor": { "$ref": "#/$defs/Cursor" },
        "tracks_upserted": { "type": "array", "items": { "$ref": "#/$defs/Track" }, "maxItems": 500 },
        "events_upserted": { "type": "array", "items": { "$ref": "#/$defs/Event" }, "maxItems": 500 },
        "coverage_upserted": { "type": "array", "items": { "$ref": "#/$defs/Coverage" }, "maxItems": 500 }
      },
      "required": ["schema_version", "kind", "sequence", "cursor", "previous_cursor", "tracks_upserted", "events_upserted", "coverage_upserted"],
      "additionalProperties": false
    },
    "ResyncRequiredMessage": {
      "description": "WebSocket: the client must discard state and wait for a fresh snapshot.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "kind": { "const": "resync_required" },
        "reason": { "enum": ["gap", "reconnect", "overflow", "expired_cursor"] },
        "last_cursor": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
      },
      "required": ["schema_version", "kind", "reason", "last_cursor"],
      "additionalProperties": false
    },
    "SubscribeMessage": {
      "description": "WebSocket client request for a bounded area, interval and layer set.",
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "kind": { "const": "subscribe" },
        "bbox": { "$ref": "#/$defs/BBox" },
        "interval": { "$ref": "#/$defs/Interval" },
        "layers": {
          "type": "array",
          "items": { "enum": ["flight", "vessel", "road"] },
          "minItems": 1,
          "maxItems": 3
        },
        "resume_cursor": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" }
      },
      "required": ["schema_version", "kind", "bbox", "interval", "layers", "resume_cursor"],
      "additionalProperties": false
    },
    "UnsubscribeMessage": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "kind": { "const": "unsubscribe" }
      },
      "required": ["schema_version", "kind"],
      "additionalProperties": false
    },
    "ServerMessage": {
      "description": "Every message the server sends over REST or WebSocket.",
      "oneOf": [
        { "$ref": "#/$defs/HealthMessage" },
        { "$ref": "#/$defs/ErrorMessage" },
        { "$ref": "#/$defs/SnapshotMessage" },
        { "$ref": "#/$defs/DeltaMessage" },
        { "$ref": "#/$defs/ResyncRequiredMessage" }
      ]
    },
    "ClientMessage": {
      "description": "Every message a client sends over WebSocket.",
      "oneOf": [
        { "$ref": "#/$defs/SubscribeMessage" },
        { "$ref": "#/$defs/UnsubscribeMessage" }
      ]
    }
  }
}
