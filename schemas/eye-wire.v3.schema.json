        "kind",
        "source",
        "source_record_id",
        "display_type",
        "points",
        "quality_flags"
      ],
      "additionalProperties": false,
      "description": "A track with a route: at least one resolved point, and any unresolved conflicts."
    },
    "TrackUnresolved": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "flight",
            "vessel"
          ]
