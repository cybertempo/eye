    "SubjectIdentifier": {
      "type": "string",
      "description": "scheme:value. The track scheme names source:layer:record of an EYE track; other schemes are shown but not matched.",
      "pattern": "^(track|registration|callsign|mmsi|imo|plate):[A-Za-z0-9._:-]{1,120}$",
      "maxLength": 128
    },
    "SubscribeMessage": {
      "description": "WebSocket client request for a bounded area, interval and layer set.",
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "kind": {
          "const": "subscribe"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "layers": {
          "type": "array",
          "items": {
            "enum": [
              "flight",
              "vessel",
              "road"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        },
        "resume_cursor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "bbox",
        "interval",
        "layers",
        "resume_cursor"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "description": "RFC 3339 instant in UTC with a Z suffix, on a real calendar date.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$",
      "format": "date-time"
    },
    "Track": {
      "description": "One (source, layer, record). points holds resolved positions only and forms the route. conflicts holds observed times whose latest publication is contested: every claim is kept with its evidence, none is joined to the route or chosen as the position. A track has at least one point or conflict.",
      "oneOf": [
        {
          "$ref": "#/$defs/TrackRouted"
        },
        {
          "$ref": "#/$defs/TrackUnresolved"
        }
      ]
    },
    "TrackLink": {
      "description": "A case is linked to a track only when exactly one track matches its identifiers, window and location; otherwise it stays unlinked with the reason.",
      "oneOf": [
        {
          "$ref": "#/$defs/TrackLinked"
        },
        {
          "$ref": "#/$defs/TrackNotLinked"
        }
      ]
    },
    "TrackLinked": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "linked"
        },
        "track_id": {
          "$ref": "#/$defs/Identifier"
        },
        "reason": {
          "$ref": "#/$defs/ShortText"
        },
        "candidate_track_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 10
        }
      },
      "required": [
        "state",
        "track_id",
        "reason",
        "candidate_track_ids"
      ]
    },
    "TrackNotLinked": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "unlinked",
            "ambiguous",
            "not_applicable"
          ]
        },
        "track_id": {
          "type": "null"
        },
        "reason": {
          "$ref": "#/$defs/ShortText"
        },
        "candidate_track_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 10
        }
      },
      "required": [
        "state",
        "track_id",
        "reason",
        "candidate_track_ids"
      ]
    },
    "TrackPoint": {
      "description": "Source time and server receipt time are separate fields.",
      "type": "object",
      "properties": {
        "observed_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "received_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "lon": {
          "$ref": "#/$defs/Longitude"
        },
        "lat": {
          "$ref": "#/$defs/Latitude"
        },
        "alt_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -12000,
          "maximum": 100000
        }
      },
      "required": [
        "observed_time",
        "received_time",
        "lon",
        "lat",
        "alt_m"
      ],
      "additionalProperties": false
    },
    "TrackRouted": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
