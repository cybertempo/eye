{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eye.invalid/schemas/eye-wire.v3.schema.json",
  "title": "EYE wire protocol, version 3",
  "description": "Authoritative definition of every REST response and WebSocket message. Uses only the keyword subset listed in schemas/README.md. Client types are generated from this file; both sides validate against it at runtime.",
  "$defs": {
    "AlgorithmVersion": {
      "description": "Name and version of a deterministic derivation, such as transit-counter/2.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"
    },
    "Area": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/ShortText"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        }
      },
      "required": [
        "name",
        "bbox"
      ],
      "additionalProperties": false
    },
    "BBox": {
      "description": "[west, south, east, north] in WGS 84 degrees.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/Longitude"
        },
        {
          "$ref": "#/$defs/Latitude"
        },
        {
          "$ref": "#/$defs/Longitude"
        },
        {
          "$ref": "#/$defs/Latitude"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "CandidateClaim": {
      "type": "object",
      "additionalProperties": false,
      "description": "A review candidate inferred from motion data (lost signal, AIS gap, stopped vessel, traffic slowdown). It never reports an accident, casualty or collision.",
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "is_current": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "event_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$",
          "format": "date-time"
        },
        "event_time_uncertainty_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2592000
        },
        "published_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "received_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "reported_event_location": {
          "$ref": "#/$defs/EventLocation"
        },
        "evidence_batch_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "subject_identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubjectIdentifier"
          },
          "maxItems": 10
        },
        "subject_window": {
          "oneOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        "basis": {
          "const": "motion_inference"
        },
        "kind": {
          "enum": [
            "signal_lost",
            "ais_gap",
            "vessel_stopped",
            "traffic_slowdown"
          ]
        },
        "status": {
          "const": "candidate"
        },
        "evidence_ref": {
          "type": "null"
        }
      },
      "required": [
        "claim_id",
        "version",
        "is_current",
        "basis",
        "kind",
        "status",
        "event_time",
        "event_time_uncertainty_s",
        "published_time",
        "received_time",
        "reported_event_location",
        "evidence_ref",
        "evidence_batch_ids",
        "subject_identifiers",
        "subject_window",
        "summary"
      ]
    },
    "ClientMessage": {
      "description": "Every message a client sends over WebSocket.",
      "oneOf": [
        {
          "$ref": "#/$defs/SubscribeMessage"
        },
        {
          "$ref": "#/$defs/UnsubscribeMessage"
        }
      ]
    },
    "ConflictClaim": {
      "description": "One claim in a publication conflict: an observation the source published at the same time as another for the same record and observed time.",
      "type": "object",
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "published_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "received_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "lon": {
          "$ref": "#/$defs/Longitude"
        },
        "lat": {
          "$ref": "#/$defs/Latitude"
        },
        "alt_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -12000,
          "maximum": 100000
        },
        "evidence_batch_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "observation_id",
        "published_time",
        "received_time",
        "lon",
        "lat",
        "alt_m",
        "evidence_batch_ids"
      ],
      "additionalProperties": false
    },
    "CountLine": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "name": {
          "$ref": "#/$defs/ShortText"
        },
        "synthetic": {
          "type": "boolean"
        },
        "coords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "synthetic",
        "coords"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "oneOf": [
        {
          "$ref": "#/$defs/CoverageMeasured"
        },
        {
          "$ref": "#/$defs/CoverageMissing"
        }
      ]
    },
    "CoverageMeasured": {
      "description": "Coverage with a usable measurement. The metric value is a number.",
      "type": "object",
      "properties": {
        "layer": {
          "enum": [
            "flight",
            "vessel",
            "road"
          ]
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "state": {
          "enum": [
            "qualified",
            "partial"
          ]
        },
        "reason": {
          "$ref": "#/$defs/ShortText"
        },
        "metric": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/Identifier"
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "name",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "layer",
        "interval",
        "state",
        "metric"
      ],
      "additionalProperties": false
    },
    "CoverageMissing": {
      "description": "An outage or unknown coverage. The metric value must be null, never zero.",
      "type": "object",
      "properties": {
        "layer": {
          "enum": [
            "flight",
            "vessel",
            "road"
          ]
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "state": {
          "enum": [
            "unknown",
            "failed"
          ]
        },
        "reason": {
          "$ref": "#/$defs/ShortText"
        },
        "metric": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/Identifier"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "layer",
        "interval",
        "state",
        "reason",
        "metric"
      ],
      "additionalProperties": false
    },
    "Cursor": {
      "description": "Opaque position in the server's update sequence.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "DeltaMessage": {
      "description": "WebSocket sequenced update after a snapshot. A gap in sequence requires a new snapshot.",
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "kind": {
          "const": "delta"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "previous_cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "tracks_upserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Track"
          },
          "maxItems": 500
        },
        "events_upserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventCase"
          },
          "maxItems": 500
        },
        "coverage_upserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Coverage"
          },
          "maxItems": 500
        }
      },
      "required": [
        "schema_version",
        "kind",
        "sequence",
        "cursor",
        "previous_cursor",
        "tracks_upserted",
        "events_upserted",
        "coverage_upserted"
      ],
      "additionalProperties": false
    },
    "DisplayType": {
      "description": "How a displayed state was obtained (brief section 4).",
      "enum": [
        "observed",
        "ephemeris",
        "propagated",
        "estimated",
        "illustrative"
      ]
    },
    "ErrorMessage": {
      "description": "Any REST error body, or a WebSocket error before close.",
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "kind": {
          "const": "error"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "error": {
          "$ref": "#/$defs/ShortText"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "status",
        "error"
      ],
      "additionalProperties": false
    },
    "EventArea": {
      "type": "object",
      "additionalProperties": false,
      "description": "An area as a closed ring (first position repeated last).",
      "properties": {
        "type": {
          "const": "area"
        },
        "coords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          },
          "minItems": 4,
          "maxItems": 100
        },
        "precision_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "type",
        "coords",
        "precision_m"
      ]
    },
    "EventCase": {
      "type": "object",
      "additionalProperties": false,
      "description": "One source's case in the append-only event-claim ledger: every version (corrections, retractions, conflicting claims), the reported location of each, and, separately, the last observed position of a conservatively linked track.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "layer": {
          "enum": [
            "flight",
            "vessel",
            "road"
          ]
        },
        "source": {
          "$ref": "#/$defs/Identifier"
        },
        "source_label": {
          "$ref": "#/$defs/ShortText"
        },
        "case_id": {
          "$ref": "#/$defs/Identifier"
        },
        "standing": {
          "description": "report: the current version is a sourced report; review_candidate: motion data only; unresolved: the latest versions conflict; retracted: the source withdrew it.",
          "enum": [
            "report",
            "review_candidate",
            "unresolved",
            "retracted"
          ]
        },
        "current_claim_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventClaim"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "link": {
          "$ref": "#/$defs/TrackLink"
        },
        "last_observed_position": {
          "oneOf": [
            {
              "$ref": "#/$defs/LastObserved"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "layer",
        "source",
        "source_label",
        "case_id",
        "standing",
        "current_claim_id",
        "claims",
        "link",
        "last_observed_position"
      ]
    },
    "EventClaim": {
      "description": "One version of a case as its source published it.",
      "oneOf": [
        {
          "$ref": "#/$defs/ReportClaim"
        },
        {
          "$ref": "#/$defs/CandidateClaim"
        }
      ]
    },
    "EventLocation": {
      "description": "Where the source reported the event, at the source's stated precision. Never a last observed position.",
      "oneOf": [
        {
          "$ref": "#/$defs/EventPoint"
        },
        {
          "$ref": "#/$defs/EventSegment"
        },
        {
          "$ref": "#/$defs/EventArea"
        }
      ]
    },
    "EventPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "point"
        },
        "coords": {
          "$ref": "#/$defs/Position"
        },
        "precision_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "type",
        "coords",
        "precision_m"
      ]
    },
    "EventSegment": {
      "type": "object",
      "additionalProperties": false,
      "description": "A road or route segment. direction forward: only the direction of travel from the first to the last position is affected.",
      "properties": {
        "type": {
          "const": "segment"
        },
        "coords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          },
          "minItems": 2,
          "maxItems": 100
        },
        "precision_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "direction": {
          "enum": [
            "forward",
            "both"
          ]
        }
      },
      "required": [
        "type",
        "coords",
        "precision_m",
        "direction"
      ]
    },
    "HealthMessage": {
      "description": "REST GET /api/v0/health.",
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "kind": {
          "const": "health"
        },
        "status": {
          "const": "ok"
        },
        "mode": {
          "enum": [
            "demo",
            "production"
          ]
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "status",
        "mode",
        "synthetic"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Interval": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/Timestamp"
        },
        "end": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "LastObserved": {
      "type": "object",
      "additionalProperties": false,
      "description": "The linked track's last resolved position at or before the event (or the end of the subject window). An observation, not a reported site.",
      "properties": {
        "track_id": {
          "$ref": "#/$defs/Identifier"
        },
        "observation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/Identifier"
        },
        "source_record_id": {
          "$ref": "#/$defs/Identifier"
        },
        "observed_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "received_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "lon": {
          "$ref": "#/$defs/Longitude"
        },
        "lat": {
          "$ref": "#/$defs/Latitude"
        },
        "alt_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -12000,
          "maximum": 100000
        }
      },
      "required": [
        "track_id",
        "observation_id",
        "source",
        "source_record_id",
        "observed_time",
        "received_time",
        "lon",
        "lat",
        "alt_m"
      ]
    },
    "Latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "Longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "Position": {
      "description": "[longitude, latitude] in WGS 84 degrees.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/Longitude"
        },
        {
          "$ref": "#/$defs/Latitude"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "PositionConflict": {
      "description": "An observed time whose latest publication is contested. Unresolved until a later, unique publication supersedes every claim.",
      "type": "object",
      "properties": {
        "observed_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConflictClaim"
          },
          "minItems": 2,
          "maxItems": 20
        }
      },
      "required": [
        "observed_time",
        "claims"
      ],
      "additionalProperties": false
    },
    "ReportClaim": {
      "type": "object",
      "additionalProperties": false,
      "description": "A sourced report: an official or operator publication, citing its evidence.",
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "is_current": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "event_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$",
          "format": "date-time"
        },
        "event_time_uncertainty_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2592000
        },
        "published_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "received_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "reported_event_location": {
          "$ref": "#/$defs/EventLocation"
        },
        "evidence_batch_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "subject_identifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubjectIdentifier"
          },
          "maxItems": 10
        },
        "subject_window": {
          "oneOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        "basis": {
          "enum": [
            "official_report",
            "operator_report"
          ]
        },
        "kind": {
          "enum": [
            "aviation_accident",
            "aviation_incident",
            "emergency_declared",
            "diversion",
            "flight_arrival",
            "marine_casualty",
            "vessel_distress",
            "vessel_port_arrival",
            "road_collision",
            "road_incident",
            "road_closure",
            "road_congestion"
          ]
        },
        "status": {
          "enum": [
            "reported",
            "preliminary",
            "final",
            "retracted",
            "cleared"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "claim_id",
        "version",
        "is_current",
        "basis",
        "kind",
        "status",
        "event_time",
        "event_time_uncertainty_s",
        "published_time",
        "received_time",
        "reported_event_location",
        "evidence_ref",
        "evidence_batch_ids",
        "subject_identifiers",
        "subject_window",
        "summary"
      ]
    },
    "ResyncRequiredMessage": {
      "description": "WebSocket: the client must discard state and wait for a fresh snapshot.",
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "kind": {
          "const": "resync_required"
        },
        "reason": {
          "enum": [
            "gap",
            "reconnect",
            "overflow",
            "expired_cursor"
          ]
        },
        "last_cursor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "reason",
        "last_cursor"
      ],
      "additionalProperties": false
    },
    "SchemaVersion": {
      "description": "Wire protocol version carried by every message.",
      "const": "eye.wire/3"
    },
    "ServerMessage": {
      "description": "Every message the server sends over REST or WebSocket.",
      "oneOf": [
        {
          "$ref": "#/$defs/HealthMessage"
        },
        {
          "$ref": "#/$defs/ErrorMessage"
        },
        {
          "$ref": "#/$defs/SnapshotMessage"
        },
        {
          "$ref": "#/$defs/DeltaMessage"
        },
        {
          "$ref": "#/$defs/ResyncRequiredMessage"
        },
        {
          "$ref": "#/$defs/TransitsMessage"
        }
      ]
    },
    "ShortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "SnapshotMessage": {
      "description": "REST GET /api/v0/snapshot, and the first WebSocket message after subscribe or resync.",
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "kind": {
          "const": "snapshot"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "generated_at": {
