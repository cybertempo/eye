          "$ref": "#/$defs/Identifier"
        },
        "display_type": {
          "$ref": "#/$defs/DisplayType"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrackPoint"
          },
          "maxItems": 0
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 16
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PositionConflict"
          },
          "maxItems": 100,
          "minItems": 1
        }
      },
      "required": [
